# Variables de entorno para Portainer Stack / Docker Compose
# Configura estas variables en Portainer -> Stacks -> Environment variables

# Token del bot de Telegram obtenido de @BotFather (opcional si solo usas el portal web)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Tu ID numérico de Telegram (puedes obtenerlo enviando un mensaje a @userinfobot)
TELEGRAM_CHAT_ID=987654321

# Frecuencia en minutos de recolección de métricas silenciosas en segundo plano
CHECK_INTERVAL_MINUTES=5

# Zona horaria del contenedor
TZ=Europe/Madrid

# Puerto HTTP del portal web
PORT=3000
